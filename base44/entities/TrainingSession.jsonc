{
  "name": "TrainingSession",
  "type": "object",
  "properties": {
    "trade": {
      "type": "string"
    },
    "trades": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "level": {
      "type": "string"
    },
    "scenario_type": {
      "type": "string"
    },
    "setting": {
      "type": "string"
    },
    "scenario_text": {
      "type": "string"
    },
    "user_answer": {
      "type": "string"
    },
    "evaluation_text": {
      "type": "string"
    },
    "ideal_answer_text": {
      "type": "string"
    },
    "score_safety": {
      "type": "number"
    },
    "score_code": {
      "type": "number"
    },
    "score_workmanship": {
      "type": "number"
    },
    "score_completeness": {
      "type": "number"
    },
    "score_judgment": {
      "type": "number"
    },
    "score_total": {
      "type": "number"
    },
    "is_personal_scenario": {
      "type": "boolean",
      "default": false
    },
    "personal_description": {
      "type": "string"
    },
    "session_date": {
      "type": "string",
      "format": "date"
    },
    "rubric_scope": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Which of the 5 scoring categories this scenario's task actually called for"
    },
    "followup_complication": {
      "type": "string",
      "description": "A complication/pushback raised after the initial evaluation for the trainee to respond to"
    },
    "followup_answer": {
      "type": "string",
      "description": "The trainee's response to the follow-up complication"
    },
    "followup_verdict": {
      "type": "string",
      "enum": [
        "handled_well",
        "partially_handled",
        "missed_the_point"
      ],
      "description": "Lighter verdict on how well the trainee adapted to the complication"
    },
    "followup_feedback": {
      "type": "string",
      "description": "Feedback explaining the follow-up verdict"
    },
    "omitted_fact": {
      "type": "string",
      "description": "A fact deliberately omitted from the scenario per the level's information-handling mode (empty if none)"
    },
    "red_herring": {
      "type": "string",
      "description": "An irrelevant/misleading detail included in the scenario per the level's information-handling mode (empty if none)"
    }
  },
  "required": []
}